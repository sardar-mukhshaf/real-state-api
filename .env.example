# Docker Compose reads this file after you copy it to .env.
# Java launched directly reads environment variables, not this file automatically.
DATABASE_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
# Set both for the first start, then remove them after the admin has been created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# For Java running on the host (Compose overrides service addresses internally):
DATABASE_URL=jdbc:postgresql://localhost:5432/real_estate
DATABASE_USER=real_estate
REDIS_HOST=localhost
REDIS_PORT=6379
S3_BUCKET=real-estate
S3_ENDPOINT=http://localhost:9090
S3_PUBLIC_ENDPOINT=http://localhost:9090
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-development
AWS_SECRET_ACCESS_KEY=local-development

